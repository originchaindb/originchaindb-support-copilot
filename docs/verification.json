  "answers": [
    {
      "id": "q01",
      "question": "How do I invite a teammate?",
      "expected_status": "draft",
      "passed": true,
      "elapsed_s": 46.568,
      "answer": "To invite a teammate, open Settings > Members, select Invite member, enter their email address, and choose a role. Invitations expire after seven days.",
      "status": "draft",
      "citations": [
        {
          "id": "ab9b6d1c7a14b4624d46982d",
          "source": "01-workspaces.md",
          "version": "39ba5b48a9e6cc019420fdacedccfc0c5ce903c8265727d93b9eca5b25d633d9",
          "start_line": 1,
          "end_line": 24,
          "quote": "To invite a teammate, open Settings > Members, select Invite member, enter their email address, and choose a role. Invitations expire after seven days."
        }
      ]
    },
    {
      "id": "q10",
      "question": "How do I export workspace data?",
      "expected_status": "draft",
      "passed": true,
      "elapsed_s": 77.811,
      "answer": "To export workspace data in BeaconDesk, workspace owners can access the Data page under Settings. From there, they can initiate an export by selecting the 'Export workspace' option. The export will contain projects and tasks as CSV files in a ZIP archive. It's important to note that attachments are listed by filename but their binary data is not included in the export. The export is sent to the workspace owner's email address, and the download link expires after 24 hours. If the link expires, the owner can create another export from the same Data page. The export reflects a snapshot taken when the export job starts, and tasks changed after that point will appear in a later export. Exporting does not remove or modify the original workspace data.",
      "status": "draft",
      "citations": [
        {
          "id": "49358d1f64b943fddf284213",
          "source": "04-exports.md",
          "version": "89bb1f34ad1eb9138dd728ffde225c261ff2e8ca124c5913f2b339fb9e30a15d",
          "start_line": 1,
          "end_line": 13,
          "quote": "Workspace owners can export data from Settings > Data > Export workspace. The export contains projects and tasks as CSV files in a ZIP archive. Attachments are listed by filename; attachment binaries are not included."
        },
        {
          "id": "49358d1f64b943fddf284213",
          "source": "04-exports.md",
          "version": "89bb1f34ad1eb9138dd728ffde225c261ff2e8ca124c5913f2b339fb9e30a15d",
          "start_line": 1,
          "end_line": 13,
          "quote": "When the export is ready, BeaconDesk sends a download link to the workspace owner's email address. The download link expires after twenty-four hours."
        }
