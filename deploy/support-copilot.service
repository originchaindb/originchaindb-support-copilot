[Unit]
Description=OriginChainDB Support Copilot internal FAQ
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=simple
User=copilot
Group=copilot
WorkingDirectory=/opt/support-copilot
ExecStart=/opt/support-copilot/.venv/bin/support-copilot serve --port 8000
Restart=on-failure
RestartSec=5
StateDirectory=support-copilot
StateDirectoryMode=0700
Environment=COPILOT_STATE_DIR=/var/lib/support-copilot
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
