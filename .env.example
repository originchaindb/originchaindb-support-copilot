# Copy the database endpoint, tenant and bearer from your OriginChainDB console.
# This is an engine connection, not a GitHub or management-account token.
OC_BASE_URL=https://your-database-endpoint
OC_TENANT=your-tenant-id
OC_BEARER=

# Optional database-user authentication, if required by your connection.
OC_DB_USER=
OC_DB_KEY=

# Local Ollama. Model downloads and local RAM/disk are separate from database storage.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Set to 1 if the GPU runtime is unavailable or fails. This affects these requests only.
OLLAMA_CPU_ONLY=0

# Use your own distinct prefix if another copy uses the same database.
COPILOT_NAMESPACE=founder_support
COPILOT_STATE_DIR=.support-copilot
# Exact hostnames only. Add your HTTPS proxy hostname when deploying (see docs/PRODUCTION.md).
COPILOT_ALLOWED_HOSTS=127.0.0.1,localhost
